-- Tabela de status
CREATE TABLE IF NOT EXISTS status (
    id SERIAL PRIMARY KEY,
    nome_status VARCHAR(50) NOT NULL UNIQUE
);

INSERT INTO status (nome_status) VALUES
('Pendente'),
('Em andamento'),
('Resolvido');

-- Tabela de reports
CREATE TABLE IF NOT EXISTS report (
    id SERIAL PRIMARY KEY,
    endereco VARCHAR(100) NOT NULL,
    categoria_id INT NOT NULL REFERENCES categoria(id) ON DELETE RESTRICT,
    status_id INT NOT NULL DEFAULT 1 REFERENCES status(id) ON DELETE RESTRICT,
    usuario_id INT NOT NULL REFERENCES usuario(id_usuario) ON DELETE CASCADE,
    duracao INT,
    descricao VARCHAR(500) NOT NULL,
    url_imagem VARCHAR(500) NOT NULL,
    data_criacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    data_atualizacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Trigger para atualizar data_atualizacao automaticamente
CREATE OR REPLACE FUNCTION update_data_atualizacao()
RETURNS TRIGGER AS $$
BEGIN
  NEW.data_atualizacao = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_update_data_atualizacao
BEFORE UPDATE ON report
FOR EACH ROW
EXECUTE FUNCTION update_data_atualizacao();

-- View para listar problemas
CREATE OR REPLACE VIEW listar_problemas AS
SELECT 
    r.id,
    r.endereco,
    c.nome_categoria,
    s.nome_status,
    r.usuario_id,
    r.duracao,
    r.url_imagem,
    r.data_criacao
FROM report r
JOIN categoria c ON r.categoria_id = c.id
JOIN status s ON r.status_id = s.id;

-- view para listar problemas complestos
CREATE OR REPLACE view view_reports_completos as
select
r.id as id_report,
r.endereco as local_problema,
r.url_imagem as imagem,
c.nome_categoria as categoria,
s.nome_status as status,
u.nome as nome_usuario,
r.descricao,
r.duracao as dias_em_aberto,
TO_CHAR(r.data_criacao, 'DD/MM/YYYY HH24:MI') AS data_criacao_formatada,
TO_CHAR(r.data_atualizacao, 'DD/MM/YYYY HH24:MI') AS ultima_atualizacao
from report r
join
  categoria c on r.categoria_id = c.id
join 
  status s on r.status_id = s.id
JOIN 
    usuario u ON r.usuario_id = u.id_usuario;


