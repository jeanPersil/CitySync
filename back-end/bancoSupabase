-- Criar schema (não existe CREATE DATABASE no Supabase)
-- As tabelas serão criadas no schema padrão "public"

-- Tabela de estados
CREATE TABLE IF NOT EXISTS estado (
    id_estado SERIAL PRIMARY KEY,
    estado_nome VARCHAR(30)
);

INSERT INTO estado (estado_nome) VALUES ('Bahia');

-- Tabela de cidades
CREATE TABLE IF NOT EXISTS cidade (
    id_cidade SERIAL PRIMARY KEY,
    cidade_nome VARCHAR(30),
    fk_estado INT REFERENCES estado(id_estado) ON DELETE CASCADE
);

INSERT INTO cidade (cidade_nome, fk_estado) VALUES ('Feira de Santana', 1);

-- Tabela de endereços
CREATE TABLE IF NOT EXISTS endereco (
    id_endereco SERIAL PRIMARY KEY,
    logradouro VARCHAR(100) NOT NULL,
    numero VARCHAR(15) NOT NULL,
    bairro VARCHAR(30) NOT NULL,
    cep VARCHAR(8) NOT NULL,
    fk_cidade INT NOT NULL REFERENCES cidade(id_cidade) ON DELETE CASCADE
);

-- Tabela de usuários
CREATE TABLE IF NOT EXISTS usuario (
    id_usuario SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf VARCHAR(11) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    senha VARCHAR(100) NOT NULL,
    telefone VARCHAR(20) NOT NULL,
    id_endereco INT REFERENCES endereco(id_endereco) ON DELETE SET NULL
    tipo_usuario TEXT NOT NULL DEFAULT 'usuario' CHECK (tipo_usuario IN ('usuario', 'admin'))
);

-- Tabela de categorias
CREATE TABLE IF NOT EXISTS categoria (
    id SERIAL PRIMARY KEY,
    nome_categoria VARCHAR(50) NOT NULL UNIQUE
);

