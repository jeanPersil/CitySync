CREATE DATABASE IF NOT EXISTS citySync;
USE citySync;


CREATE TABLE estado(
    id_estado INT AUTO_INCREMENT PRIMARY KEY,
    estado_nome VARCHAR(30)
);

INSERT INTO estado (estado_nome) VALUES ('Bahia');

CREATE TABLE cidade (
    id_cidade INT AUTO_INCREMENT PRIMARY KEY,
    cidade_nome VARCHAR(30),
    fk_estado INT,
    
    FOREIGN KEY (fk_estado) REFERENCES estado(id_estado)
);

INSERT INTO cidade (cidade_nome, fk_estado) VALUES ('Feira de Santana', 1);

CREATE TABLE endereco (
    id_endereco INT AUTO_INCREMENT PRIMARY KEY,
    logradouro VARCHAR(100) NOT NULL,
    numero VARCHAR(15) NOT NULL,     
    bairro VARCHAR(30) NOT NULL,
    cep CHAR(8) NOT NULL,              
    fk_cidade INT NOT NULL,            
    FOREIGN KEY (fk_cidade) REFERENCES cidade(id_cidade)     
);


CREATE TABLE usuario (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf CHAR(11) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    senha VARCHAR(100) NOT NULL,
    telefone VARCHAR(20) NOT NULL,
    
    id_endereco INT,
    FOREIGN KEY (id_endereco) REFERENCES endereco(id_endereco)
);

CREATE TABLE categoria (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome_categoria VARCHAR(50) NOT NULL UNIQUE
);

INSERT INTO categoria (nome_categoria)
VALUES 
  ('Buraco'),
  ('Iluminação'),
  ('Lixo'),
  ('Semafaro'),
  ('Vazamento/esgoto'),
  ('Transporte'),
  ('Outros');

CREATE TABLE status (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome_status VARCHAR(50) NOT NULL UNIQUE
);

INSERT INTO status (nome_status)
VALUES 
  ('Pendente'),
  ('Em andamento'),
  ('Resolvido');


CREATE TABLE report (
    id INT AUTO_INCREMENT PRIMARY KEY,
    endereco VARCHAR(100) NOT NULL,
    categoria_id INT NOT NULL,
    status_id INT NOT NULL DEFAULT 1, 
    usuario_id INT NOT NULL,
    duracao INT,
    descricao VARCHAR(500) NOT NULL, 
    url_imagem VARCHAR(500) NOT NULL, 
    data_criacao DATETIME DEFAULT CURRENT_TIMESTAMP,
    data_atualizacao DATETIME ON UPDATE CURRENT_TIMESTAMP,

    FOREIGN KEY (usuario_id) REFERENCES usuario(id_usuario) ON DELETE CASCADE,
    FOREIGN KEY (categoria_id) REFERENCES categoria(id) ON DELETE RESTRICT,
    FOREIGN KEY (status_id) REFERENCES status(id) ON DELETE RESTRICT

);