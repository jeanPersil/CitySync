CREATE DATABASE IF NOT EXISTS citySync;
USE citySync;

CREATE TABLE endereco (
    id_endereco INT AUTO_INCREMENT PRIMARY KEY,
    logradouro VARCHAR(100) NOT NULL,
    numero_casa VARCHAR(10) NOT NULL,
    bairro VARCHAR(30) NOT NULL,
    cidade VARCHAR(30) NOT NULL,
    estado VARCHAR(30) NOT NULL,
    cep VARCHAR(10) NOT NULL     
);

CREATE TABLE usuario (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf CHAR(11) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    senha VARCHAR(100) NOT NULL,
    telefone VARCHAR(20) NOT NULL,
    
    id_endereco INT,
    FOREIGN KEY (id_endereco) REFERENCES endereco(id_endereco)
);

CREATE TABLE categoria (
    id_categoria INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(50) NOT NULL UNIQUE 
);

CREATE TABLE report (
    id_report INT AUTO_INCREMENT PRIMARY KEY,
    endereco VARCHAR(100) NOT NULL,
    id_categoria INT,
    duracao INT,
    descricao VARCHAR(255) NOT NULL, 
    url_imagem varchar(200) NOT NULL,
    data_report TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    id_usuario INT,

    FOREIGN KEY (usuario_id) REFERENCES usuario(id_usuario) ON DELETE CASCADE,
    FOREIGN KEY (categoria_id) REFERENCES categoria(id) ON DELETE RESTRICT,
    FOREIGN KEY (status_id) REFERENCES status(id) ON DELETE RESTRICT

);


CREATE VIEW listar_problemas AS
SELECT 
    report.id,
    report.endereco,
    categoria.nome_categoria,
    status.nome_status,
    report.usuario_id,
    report.duracao,
    report.url_imagem,
    report.data_criacao
FROM 
    report
JOIN 
    categoria ON report.categoria_id = categoria.id
JOIN 
    status ON report.status_id = status.id;